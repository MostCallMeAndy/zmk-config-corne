#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  :  |  -  |
// | CTRL |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  |  '  |
// | SHFT |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | ENT |
//                    | GUI | LWR | BSP |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp F &kp P &kp B   &kp J &kp L  &kp U     &kp Y   &kp SEMI &kp MINUS
   &kp LCTRL &kp A &kp R &kp S &kp T &kp G   &kp M &kp N  &kp E     &kp I   &kp O    &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp D &kp V   &kp K &kp H  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp BSPC  &kp SPACE &mo 2 &kp RALT
                        >;
                };
//                lower_layer {
//                        display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  \  |
// | CTRL |     |     |     |     |     |   |  +  |  4  |  5  |  6  |  -  |  =  |
// | SHFT |BTCLR| BT0 | BT1 | BT2 | BT3 |   |  *  |  1  |  2  |  3  |  /  |     |
//                    | GUI |     | BSP |   |     |  0  |  .  |
//                        bindings = <
//   &kp TAB    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0    &kp BSLH
//   &kp LCTRL  &none        &none        &none        &none        &none          &kp PLUS  &kp N4   &kp N5 &kp N6   &kp MINUS &kp EQUAL
//   &kp LSHFT  &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &kp ASTRK &kp K1   &kp N2 &kp N3   &kp FSLH  &none
//                                        &kp LGUI     &trans       &kp BSPC       &kp SPACE &kp N0   &kp DOT
//                        >;
//                };

                raise_layer {
                      display-name = "Raise Layer";
// -----------------------------------------------------------------------------------------
// |   ~  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  |  |
// | CTRL |  (  |  )  |  [  |  ]  |     |   | LFT | DWN | UP  | RGT |     |  `  |
// | SHFT |     |     |  {  |  }  |     |   |     |     |     |     |     |     |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp TILDE &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR &kp PIPE
   &kp LCTRL &kp LPAR &kp RPAR &kp LBKT &kp RBKT &trans      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &none    &kp GRAVE
   &kp LSHFT &none    &none    &kp LBRC &kp RBRC &trans      &none     &none     &none     &none     &none    &trans
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
        };
};