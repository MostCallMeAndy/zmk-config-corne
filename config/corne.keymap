#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  F  |  P  |  B  |   |  J  |  L   |  U  |  Y  |  ;  |  -   |
// | CTRL |  A  |  R  |  S  |  T  |  G  |   |  M  |  N   |  E  |  I  |  O  |  '   |
// | SHFT |  Z  |  X  |  C  |  D  |  V  |   |  K  |  H   |  ,  |  .  |  /  | ENTR |
//                    | GUI | LWR |BKSP |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp F &kp P &kp B   &kp J &kp L  &kp U     &kp Y   &kp SEMI &kp MINUS
   &kp LCTRL &kp A &kp R &kp S &kp T &kp G   &kp M &kp N  &kp E     &kp I   &kp O    &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp D &kp V   &kp K &kp H  &kp COMMA &kp DOT &kp FSLH &kp RET
                  &kp LGUI &mo 2 &kp BSPC   &kp SPACE &mo 3 &kp RALT
                        >;
                };
                qwerty_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                 &kp LGUI &mo 2 &kp BSPC   &kp SPACE &mo 3 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  \  |
// | CTRL |     |     |     |     |     |   |  +  |  4  |  5  |  6  |  -  |  =  |
// |BCLRAL|BTCLR| BT1 | BT2 | BT3 | BT4 |   |  *  |  1  |  2  |  3  |  /  |     |
//                    | GUI |     | SPC |   |     |  0  |  .  |
                        bindings = <
   &kp ESC        &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7 &kp N8 &kp N9 &kp N0    &kp BSLH
   &kp LCTRL      &trans       &trans       &trans       &trans       &trans         &kp PLUS &kp N4 &kp N5 &kp N6 &kp MINUS &kp EQUAL
   &bt BT_CLR_ALL &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &trans   &kp N1 &kp N2 &kp N3 &kp FSLH  &trans
                                            &kp LGUI     &trans       &kp BSPC       &trans   &kp N0 &kp DOT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |  (  |  )  |  [  |  ]  |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |  {  |  }  |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |QWRTY| SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &kp LPAR &kp RPAR &kp LBKT &kp RBKT &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans   &kp LBRC &kp RBRC &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &to 1  &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };
//                adjust_layer {
// -----------------------------------------------------------------------------------------
// |  ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  \  |
// | CTRL |     |     |     |     |     |   |  +  |  4  |  5  |  6  |  -  |  =  |
// |BCLRAL|BTCLR| BT1 | BT2 | BT3 | BT4 |   |  *  |  1  |  2  |  3  |  /  |     |
//                    | GUI |     | SPC |   |     |  0  |  .  |
//                      bindings = <
//   &kp ESC        &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9 &kp N0 &kp BSLH
//   &kp LCTRL      &trans       &trans       &trans       &trans       &trans         &kp PLUS &kp N4   &kp N5 &kp N6 &kp MINUS &kp EQUAL
//   &bt BT_CLR_ALL &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &trans   &trans   &trans &trans &trans &trans
//                                            &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
//                        >;
//                };
//        };
//};
